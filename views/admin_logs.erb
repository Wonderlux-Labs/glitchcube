<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Log Viewer - Glitch Cube Admin</title>
    <style>
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, sans-serif;
            margin: 0;
            padding: 20px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
        }
        
        .container {
            max-width: 1400px;
            margin: 0 auto;
            background: rgba(255, 255, 255, 0.95);
            border-radius: 10px;
            padding: 20px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
        }
        
        h1 {
            color: #333;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        
        .controls {
            display: flex;
            gap: 10px;
            margin-bottom: 20px;
            align-items: center;
        }
        
        select, button {
            padding: 8px 12px;
            border: 1px solid #ddd;
            border-radius: 5px;
            background: white;
            cursor: pointer;
        }
        
        button {
            background: #667eea;
            color: white;
            border: none;
            transition: background 0.3s;
        }
        
        button:hover {
            background: #5a67d8;
        }
        
        .log-container {
            background: #1e1e1e;
            border-radius: 5px;
            padding: 15px;
            overflow-x: auto;
            max-height: 600px;
            overflow-y: scroll;
            font-family: 'Monaco', 'Menlo', 'Ubuntu Mono', monospace;
            font-size: 12px;
        }
        
        .log-entry {
            padding: 4px 0;
            border-bottom: 1px solid #333;
            display: flex;
            align-items: flex-start;
            gap: 10px;
        }
        
        .log-entry:hover {
            background: rgba(255, 255, 255, 0.05);
        }
        
        .timestamp {
            color: #888;
            min-width: 180px;
            font-size: 11px;
        }
        
        .level {
            padding: 2px 6px;
            border-radius: 3px;
            font-weight: bold;
            min-width: 50px;
            text-align: center;
            font-size: 10px;
        }
        
        .level-debug { background: #444; color: #aaa; }
        .level-info { background: #0969da; color: white; }
        .level-warn { background: #fb8500; color: white; }
        .level-error { background: #dc2626; color: white; }
        
        .tags {
            display: flex;
            gap: 4px;
            flex-wrap: wrap;
        }
        
        .tag {
            background: #333;
            color: #67e8f9;
            padding: 2px 6px;
            border-radius: 3px;
            font-size: 10px;
        }
        
        .message {
            color: #f0f0f0;
            flex: 1;
            word-break: break-word;
        }
        
        .metadata {
            color: #888;
            font-size: 11px;
            margin-left: 10px;
            font-style: italic;
        }
        
        .loading {
            text-align: center;
            padding: 20px;
            color: #888;
        }
        
        .error {
            background: #dc2626;
            color: white;
            padding: 10px;
            border-radius: 5px;
            margin-bottom: 10px;
        }
        
        .back-link {
            color: white;
            text-decoration: none;
            background: rgba(255, 255, 255, 0.2);
            padding: 5px 10px;
            border-radius: 5px;
            font-size: 14px;
        }
        
        .stats {
            display: flex;
            gap: 20px;
            margin-bottom: 10px;
            font-size: 12px;
            color: #666;
        }
        
        .filter-input {
            flex: 1;
            padding: 8px;
            border: 1px solid #ddd;
            border-radius: 5px;
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>
            📋 Log Viewer
            <a href="/admin" class="back-link">← Back to Admin</a>
        </h1>
        
        <div class="controls">
            <select id="lineCount">
                <option value="50">Last 50 lines</option>
                <option value="100" selected>Last 100 lines</option>
                <option value="200">Last 200 lines</option>
                <option value="500">Last 500 lines</option>
                <option value="1000">Last 1000 lines</option>
            </select>
            
            <select id="levelFilter">
                <option value="">All Levels</option>
                <option value="debug">Debug</option>
                <option value="info">Info</option>
                <option value="warn">Warn</option>
                <option value="error">Error</option>
            </select>
            
            <input type="text" id="searchFilter" class="filter-input" placeholder="Search logs...">
            
            <button onclick="loadLogs()">🔄 Refresh</button>
            <button onclick="toggleAutoRefresh()" id="autoRefreshBtn">▶️ Auto-refresh: OFF</button>
        </div>
        
        <div class="stats" id="stats"></div>
        
        <div class="log-container" id="logContainer">
            <div class="loading">Loading logs...</div>
        </div>
    </div>
    
    <script>
        let autoRefreshInterval = null;
        let allLogs = [];
        
        function loadLogs() {
            const lines = document.getElementById('lineCount').value;
            
            fetch(`/admin/api/logs?lines=${lines}`)
                .then(response => response.json())
                .then(data => {
                    if (data.error) {
                        showError(data.error);
                    } else {
                        allLogs = data.logs;
                        renderLogs();
                        updateStats(data);
                    }
                })
                .catch(err => {
                    showError('Failed to load logs: ' + err.message);
                });
        }
        
        function renderLogs() {
            const container = document.getElementById('logContainer');
            const levelFilter = document.getElementById('levelFilter').value;
            const searchFilter = document.getElementById('searchFilter').value.toLowerCase();
            
            let filteredLogs = allLogs;
            
            if (levelFilter) {
                filteredLogs = filteredLogs.filter(log => log.level === levelFilter);
            }
            
            if (searchFilter) {
                filteredLogs = filteredLogs.filter(log => 
                    log.message.toLowerCase().includes(searchFilter) ||
                    log.tags.some(tag => tag.toLowerCase().includes(searchFilter)) ||
                    JSON.stringify(log.metadata).toLowerCase().includes(searchFilter)
                );
            }
            
            if (filteredLogs.length === 0) {
                container.innerHTML = '<div class="loading">No logs found</div>';
                return;
            }
            
            container.innerHTML = filteredLogs.map(log => {
                const tags = log.tags.length > 0 
                    ? `<div class="tags">${log.tags.map(tag => `<span class="tag">${tag}</span>`).join('')}</div>`
                    : '';
                    
                const metadata = Object.keys(log.metadata).length > 0
                    ? `<span class="metadata">${JSON.stringify(log.metadata)}</span>`
                    : '';
                    
                return `
                    <div class="log-entry">
                        <span class="timestamp">${log.timestamp}</span>
                        <span class="level level-${log.level}">${log.level.toUpperCase()}</span>
                        ${tags}
                        <span class="message">${escapeHtml(log.message)}${metadata}</span>
                    </div>
                `;
            }).join('');
        }
        
        function updateStats(data) {
            const stats = document.getElementById('stats');
            const levelCounts = {};
            
            allLogs.forEach(log => {
                levelCounts[log.level] = (levelCounts[log.level] || 0) + 1;
            });
            
            stats.innerHTML = `
                <span>Total: ${data.total_lines} lines</span>
                ${Object.entries(levelCounts).map(([level, count]) => 
                    `<span>${level}: ${count}</span>`
                ).join('')}
                <span>File: ${data.log_file}</span>
            `;
        }
        
        function showError(message) {
            const container = document.getElementById('logContainer');
            container.innerHTML = `<div class="error">Error: ${escapeHtml(message)}</div>`;
        }
        
        function escapeHtml(text) {
            const map = {
                '&': '&amp;',
                '<': '&lt;',
                '>': '&gt;',
                '"': '&quot;',
                "'": '&#039;'
            };
            return text.replace(/[&<>"']/g, m => map[m]);
        }
        
        function toggleAutoRefresh() {
            const btn = document.getElementById('autoRefreshBtn');
            
            if (autoRefreshInterval) {
                clearInterval(autoRefreshInterval);
                autoRefreshInterval = null;
                btn.textContent = '▶️ Auto-refresh: OFF';
            } else {
                autoRefreshInterval = setInterval(loadLogs, 5000);
                btn.textContent = '⏸️ Auto-refresh: ON';
                loadLogs();
            }
        }
        
        // Event listeners
        document.getElementById('levelFilter').addEventListener('change', renderLogs);
        document.getElementById('searchFilter').addEventListener('input', renderLogs);
        
        // Load logs on page load
        loadLogs();
    </script>
</body>
</html>