<!DOCTYPE html>
<html>
<head>
  <title>Model Benchmarks - GlitchCube Admin</title>
  <style>
    body { 
      font-family: monospace; 
      background: #1a1a2e; 
      color: #eee; 
      padding: 20px;
      line-height: 1.6;
    }
    .container { max-width: 1400px; margin: 0 auto; }
    h1 { color: #f39c12; border-bottom: 2px solid #f39c12; padding-bottom: 10px; }
    h2 { color: #3498db; margin-top: 30px; }
    .nav { 
      background: #16213e; 
      padding: 15px; 
      margin-bottom: 30px;
      border-radius: 5px;
    }
    .nav a { 
      color: #3498db; 
      text-decoration: none; 
      margin-right: 20px;
      font-weight: bold;
    }
    .nav a:hover { color: #f39c12; }
    .form-section {
      background: #0f3460;
      padding: 20px;
      border-radius: 5px;
      margin-bottom: 30px;
    }
    .form-group {
      margin-bottom: 15px;
    }
    label {
      display: inline-block;
      width: 150px;
      color: #3498db;
    }
    select, input[type="text"] {
      background: #1a1a2e;
      color: #eee;
      border: 1px solid #3498db;
      padding: 5px 10px;
      border-radius: 3px;
      width: 300px;
    }
    .model-checkbox {
      margin: 5px 10px 5px 0;
    }
    .model-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
      gap: 10px;
      margin: 10px 0;
    }
    button {
      background: #27ae60;
      color: white;
      border: none;
      padding: 10px 20px;
      border-radius: 5px;
      cursor: pointer;
      font-weight: bold;
      margin-right: 10px;
    }
    button:hover { background: #2ecc71; }
    button:disabled { 
      background: #7f8c8d; 
      cursor: not-allowed;
    }
    .results {
      background: #0f3460;
      padding: 20px;
      border-radius: 5px;
      margin-top: 20px;
      display: none;
    }
    .results.active { display: block; }
    .result-card {
      background: #16213e;
      padding: 15px;
      margin: 10px 0;
      border-radius: 5px;
      border-left: 4px solid #3498db;
    }
    .result-card.winner {
      border-left-color: #f39c12;
      background: #1f3a5f;
    }
    .metric {
      display: inline-block;
      margin-right: 20px;
      padding: 5px 10px;
      background: #1a1a2e;
      border-radius: 3px;
    }
    .metric-label {
      color: #95a5a6;
      font-size: 0.9em;
    }
    .metric-value {
      color: #f39c12;
      font-weight: bold;
    }
    .loading {
      text-align: center;
      padding: 40px;
      display: none;
    }
    .loading.active { display: block; }
    .spinner {
      border: 4px solid #f3f3f3;
      border-top: 4px solid #3498db;
      border-radius: 50%;
      width: 40px;
      height: 40px;
      animation: spin 1s linear infinite;
      margin: 0 auto;
    }
    @keyframes spin {
      0% { transform: rotate(0deg); }
      100% { transform: rotate(360deg); }
    }
    .error {
      background: #c0392b;
      color: white;
      padding: 15px;
      border-radius: 5px;
      margin: 10px 0;
    }
    .success {
      background: #27ae60;
      color: white;
      padding: 15px;
      border-radius: 5px;
      margin: 10px 0;
    }
    .summary-box {
      background: #16213e;
      padding: 20px;
      border-radius: 5px;
      margin: 20px 0;
      border: 2px solid #f39c12;
    }
    .turn-details {
      background: #0a1929;
      padding: 10px;
      margin: 10px 0;
      border-radius: 3px;
      font-size: 0.9em;
    }
    .assertions {
      margin-top: 10px;
    }
    .assertion-pass {
      color: #27ae60;
    }
    .assertion-fail {
      color: #e74c3c;
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="nav">
      <a href="/admin">← Back to Admin</a>
      <a href="/admin/scenarios">Test Scenarios</a>
      <a href="/admin/benchmarks" style="color: #f39c12;">Model Benchmarks</a>
      <a href="/admin/errors">Error Tracking</a>
    </div>

    <h1>🎯 Model Benchmark Tool-Calling Comparisons</h1>

    <div class="form-section">
      <h2>Configure Benchmark Test</h2>
      
      <div class="form-group">
        <label>Test Scenario:</label>
        <select id="scenario">
          <% @scenarios.each do |scenario| %>
            <option value="<%= scenario[:filename] %>">
              <%= scenario[:scenario_name] %> - <%= scenario[:description] %>
            </option>
          <% end %>
        </select>
      </div>

      <div class="form-group">
        <label>Test Mode:</label>
        <select id="mode">
          <option value="evaluation">Evaluation (Live API calls)</option>
          <option value="regression">Regression (VCR cassettes)</option>
        </select>
      </div>

      <div class="form-group">
        <label style="vertical-align: top;">Models to Test:</label>
        <div style="display: inline-block;">
          <div><input type="checkbox" id="select-all"> <label for="select-all" style="width: auto;">Select All</label></div>
          <div class="model-grid">
            <% @all_models.each do |model| %>
              <div>
                <input type="checkbox" class="model-checkbox" id="model-<%= model.gsub('/', '-') %>" 
                       value="<%= model %>" <%= @default_models.include?(model) ? 'checked' : '' %>>
                <label for="model-<%= model.gsub('/', '-') %>" style="width: auto;"><%= model %></label>
              </div>
            <% end %>
          </div>
          <div style="margin-top: 10px;">
            <label style="width: auto;">Custom Split (tools|conversation):</label>
            <input type="text" id="custom-split" placeholder="e.g., openai/gpt-4.1-mini|anthropic/claude-sonnet-4" style="width: 400px;">
            <div style="font-size: 0.85em; color: #888; margin-top: 4px; max-width: 400px; line-height: 1.3;">
              <strong>How to use:</strong> Enter two model names separated by a <code>|</code> (pipe) to compare their tool-calling (<strong>tools</strong>) and conversation (<strong>conversation</strong>) abilities. The model before the pipe will be used for tool-calling, and the model after the pipe for conversation.<br>
              <em>Example:</em> <code>openai/gpt-4.1-mini|anthropic/claude-sonnet-4</code> will use <code>openai/gpt-4.1-mini</code> for tools and <code>anthropic/claude-sonnet-4</code> for conversation.
            </div>
          </div>
        </div>
      </div>

      <div>
        <button onclick="runBenchmark()">🚀 Run Benchmark</button>
        <button onclick="compareAll()">📊 Compare All Models</button>
        <button onclick="clearResults()">🗑️ Clear Results</button>
      </div>
    </div>

    <div class="loading" id="loading">
      <div class="spinner"></div>
      <p>Running benchmark tests... This may take a few minutes.</p>
    </div>

    <div id="results" class="results"></div>

    <% if @recent_results && @recent_results.any? %>
      <h2>📜 Recent Results</h2>
      <div class="form-section">
        <% @recent_results.first(5).each do |result| %>
          <div class="result-card">
            <strong><%= result[:filename] %></strong> - <%= result[:timestamp].strftime('%Y-%m-%d %H:%M') %>
            <button onclick="loadResult('<%= result[:filename] %>')">Load</button>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>

  <script>
    document.getElementById('select-all').addEventListener('change', function() {
      const checkboxes = document.querySelectorAll('.model-checkbox');
      checkboxes.forEach(cb => cb.checked = this.checked);
    });

    async function runBenchmark() {
      const scenario = document.getElementById('scenario').value;
      const mode = document.getElementById('mode').value;
      
      // Get selected models
      const selectedModels = [];
      document.querySelectorAll('.model-checkbox:checked').forEach(cb => {
        selectedModels.push(cb.value);
      });
      
      // Add custom split if provided
      const customSplit = document.getElementById('custom-split').value.trim();
      if (customSplit) {
        selectedModels.push(customSplit);
      }
      
      if (selectedModels.length === 0) {
        alert('Please select at least one model to test');
        return;
      }
      
      document.getElementById('loading').classList.add('active');
      document.getElementById('results').classList.remove('active');
      
      try {
        const response = await fetch('/admin/benchmarks/run', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: `scenario=${scenario}&models=${selectedModels.join(',')}&mode=${mode}`
        });
        
        const data = await response.json();
        
        if (data.success) {
          displayResults(data.results, data.summary);
        } else {
          showError(data.error);
        }
      } catch (error) {
        showError(error.message);
      } finally {
        document.getElementById('loading').classList.remove('active');
      }
    }

    async function compareAll() {
      const selectedModels = [];
      document.querySelectorAll('.model-checkbox:checked').forEach(cb => {
        selectedModels.push(cb.value);
      });
      
      if (selectedModels.length < 2) {
        alert('Please select at least 2 models to compare');
        return;
      }
      
      document.getElementById('loading').classList.add('active');
      document.getElementById('results').classList.remove('active');
      
      try {
        const response = await fetch('/admin/benchmarks/compare', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: `models=${selectedModels.join(',')}`
        });
        
        const data = await response.json();
        
        if (data.success) {
          displayComparison(data.comparison);
        } else {
          showError(data.error);
        }
      } catch (error) {
        showError(error.message);
      } finally {
        document.getElementById('loading').classList.remove('active');
      }
    }

    function displayResults(results, summary) {
      let html = '<h2>📊 Benchmark Results</h2>';
      
      if (summary) {
        html += `
          <div class="summary-box">
            <h3>Summary</h3>
            <div class="metric">
              <span class="metric-label">🏆 Best Overall:</span>
              <span class="metric-value">${summary.best_overall} (${summary.best_score}%)</span>
            </div>
            <div class="metric">
              <span class="metric-label">⚡ Fastest:</span>
              <span class="metric-value">${summary.fastest_model} (${summary.fastest_time}ms)</span>
            </div>
            <div class="metric">
              <span class="metric-label">💰 Cheapest:</span>
              <span class="metric-value">${summary.cheapest_model} ($${summary.cheapest_cost.toFixed(6)})</span>
            </div>
          </div>
        `;
      }
      
      results.forEach(result => {
        const isWinner = summary && result.model === summary.best_overall;
        html += `
          <div class="result-card ${isWinner ? 'winner' : ''}">
            <h3>${result.model} ${isWinner ? '🏆' : ''}</h3>
            <div>
              <div class="metric">
                <span class="metric-label">Success Rate:</span>
                <span class="metric-value">${result.success_rate}%</span>
              </div>
              <div class="metric">
                <span class="metric-label">Avg Latency:</span>
                <span class="metric-value">${result.avg_latency}ms</span>
              </div>
              <div class="metric">
                <span class="metric-label">Cost:</span>
                <span class="metric-value">$${result.total_cost.toFixed(6)}</span>
              </div>
              <div class="metric">
                <span class="metric-label">Assertions:</span>
                <span class="metric-value">${result.assertion_pass_rate}%</span>
              </div>
            </div>
            
            <div class="assertions">
              ${result.assertions_passed > 0 ? `<div class="assertion-pass">✅ ${result.assertions_passed} passed</div>` : ''}
              ${result.assertions_failed > 0 ? `<div class="assertion-fail">❌ ${result.assertions_failed} failed</div>` : ''}
            </div>
            
            ${result.tools_model !== result.conversation_model ? `
              <div style="margin-top: 10px; color: #95a5a6;">
                Tools: ${result.tools_model} | Conversation: ${result.conversation_model}
              </div>
            ` : ''}
          </div>
        `;
      });
      
      document.getElementById('results').innerHTML = html;
      document.getElementById('results').classList.add('active');
    }

    function displayComparison(comparison) {
      let html = '<h2>📊 Multi-Scenario Comparison</h2>';
      
      Object.entries(comparison).forEach(([model, stats]) => {
        html += `
          <div class="result-card">
            <h3>${model}</h3>
            <div>
              <div class="metric">
                <span class="metric-label">Scenarios:</span>
                <span class="metric-value">${stats.scenarios_run}</span>
              </div>
              <div class="metric">
                <span class="metric-label">Avg Success:</span>
                <span class="metric-value">${stats.avg_success_rate.toFixed(1)}%</span>
              </div>
              <div class="metric">
                <span class="metric-label">Avg Latency:</span>
                <span class="metric-value">${stats.avg_latency.toFixed(0)}ms</span>
              </div>
              <div class="metric">
                <span class="metric-label">Total Cost:</span>
                <span class="metric-value">$${stats.total_cost.toFixed(6)}</span>
              </div>
              <div class="metric">
                <span class="metric-label">Avg Assertions:</span>
                <span class="metric-value">${stats.avg_assertion_rate.toFixed(1)}%</span>
              </div>
            </div>
          </div>
        `;
      });
      
      document.getElementById('results').innerHTML = html;
      document.getElementById('results').classList.add('active');
    }

    function showError(message) {
      document.getElementById('results').innerHTML = `<div class="error">Error: ${message}</div>`;
      document.getElementById('results').classList.add('active');
    }

    function clearResults() {
      document.getElementById('results').classList.remove('active');
      document.getElementById('results').innerHTML = '';
    }

    async function loadResult(filename) {
      // TODO: Implement loading historical results
      alert('Loading historical results: ' + filename);
    }
  </script>
</body>
</html>