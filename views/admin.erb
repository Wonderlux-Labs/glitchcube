<!DOCTYPE html>
<html>
<head>
  <title>Glitch Cube Admin - Conversation Development</title>
  <style>
    body {
      font-family: monospace;
      background: #000;
      color: #0f0;
      padding: 20px;
      max-width: 1400px;
      margin: 0 auto;
      line-height: 1.4;
    }
    .panel {
      border: 1px solid #0f0;
      padding: 20px;
      margin-bottom: 20px;
      background: #001100;
    }
    h1, h2 { color: #00ff00; margin: 0 0 15px 0; }
    input, textarea, select {
      background: #000;
      color: #0f0;
      border: 1px solid #0f0;
      padding: 8px;
      width: 100%;
      box-sizing: border-box;
      font-family: monospace;
      margin-bottom: 10px;
    }
    button {
      background: #003300;
      color: #0f0;
      border: 1px solid #0f0;
      padding: 8px 15px;
      cursor: pointer;
      font-family: monospace;
      margin: 3px;
      font-size: 13px;
    }
    button:hover { background: #005500; }
    .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 15px; }
    .message {
      margin: 8px 0;
      padding: 10px;
      border-left: 3px solid #0f0;
      background: #000a00;
    }
    .user { border-left-color: #00ff00; }
    .assistant { border-left-color: #00ffff; }
    .system { border-left-color: #ffff00; color: #ffff00; }
    .error { color: #ff0000; border-left-color: #ff0000; }
    .status { color: #888; font-size: 0.9em; }
    .small { font-size: 0.85em; }
    .history {
      max-height: 500px;
      overflow-y: auto;
      background: #000;
      border: 1px solid #333;
      padding: 10px;
    }
    .sessions {
      max-height: 300px;
      overflow-y: auto;
      background: #000;
      border: 1px solid #333;
      padding: 10px;
    }
    .session-item {
      margin: 5px 0;
      padding: 8px;
      border: 1px solid #333;
      cursor: pointer;
      background: #001100;
    }
    .session-item:hover { background: #002200; }
    .flex { display: flex; gap: 10px; align-items: center; }
    .location-dropdown {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: #000;
      border: 1px solid #0f0;
      max-height: 200px;
      overflow-y: auto;
      z-index: 1000;
    }
    .location-item {
      padding: 8px;
      cursor: pointer;
      border-bottom: 1px solid #333;
      font-size: 12px;
    }
    .location-item:hover { background: #003300; }
    .location-item:last-child { border-bottom: none; }
    .location-name { color: #00ff00; font-weight: bold; }
    .location-type { color: #888; font-size: 10px; }
    .location-coords { color: #ffff00; font-size: 10px; }
  </style>
</head>
<body>
  <!-- Navigation Bar -->
  <div style="margin-bottom: 20px; padding: 15px; border: 1px solid #0f0; background: #001100;">
    <div style="display: flex; justify-content: space-between; align-items: center;">
      <div>
        <strong style="color: #00ff00;">ADMIN SECTIONS:</strong>
        <a href="/admin" style="color: #0f0; text-decoration: none; margin: 0 10px;">🏠 Home</a> |
        <a href="/admin/scenarios" style="color: #00ff41; text-decoration: none; font-weight: bold;">🧪 Scenarios</a> |
        <a href="/admin/benchmarks" style="color: #ffaa00; text-decoration: none;">📊 Benchmarks</a> |
        <a href="/admin/errors" style="color: #ff3333; text-decoration: none;">🐛 Errors</a> |
        <a href="/admin/tools" style="color: #ffff00; text-decoration: none;">🔧 Tools</a> |
        <a href="/admin/logs" style="color: #00ffff; text-decoration: none;">📋 Logs</a>
      </div>
      <div>
        <a href="/api/health" style="color: #888; text-decoration: none; font-size: 12px;">💚 Health Check</a>
      </div>
    </div>
  </div>

  <h1>🎲 GLITCH CUBE ADMIN - CONVERSATION TESTING</h1>
  
  <!-- Quick Access Dashboard -->
  <div class="panel" style="margin-bottom: 20px;">
    <h2>⚡ Quick Access</h2>
    <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px;">
      <div style="border: 1px solid #0f0; padding: 10px; text-align: center;">
        <h3 style="color: #00ff41; margin: 5px 0;">🧪 Testing</h3>
        <a href="/admin/scenarios" style="color: #0f0; text-decoration: none; display: block; margin: 5px;">→ Model Scenarios</a>
        <a href="/admin/benchmarks" style="color: #0f0; text-decoration: none; display: block; margin: 5px;">→ Benchmarks</a>
        <a href="/admin/tools" style="color: #0f0; text-decoration: none; display: block; margin: 5px;">→ Tool Testing</a>
      </div>
      <div style="border: 1px solid #0f0; padding: 10px; text-align: center;">
        <h3 style="color: #ffaa00; margin: 5px 0;">📊 Monitoring</h3>
        <a href="/admin/logs" style="color: #0f0; text-decoration: none; display: block; margin: 5px;">→ Live Logs</a>
        <a href="/admin/errors" style="color: #0f0; text-decoration: none; display: block; margin: 5px;">→ Error Tracking</a>
        <a href="/api/health" style="color: #0f0; text-decoration: none; display: block; margin: 5px;">→ Health Status</a>
      </div>
      <div style="border: 1px solid #0f0; padding: 10px; text-align: center;">
        <h3 style="color: #00ffff; margin: 5px 0;">🔍 Debugging</h3>
        <a href="#" onclick="checkStatus(); return false;" style="color: #0f0; text-decoration: none; display: block; margin: 5px;">→ System Status</a>
        <a href="#" onclick="refreshSessions(); return false;" style="color: #0f0; text-decoration: none; display: block; margin: 5px;">→ Session History</a>
        <a href="#" onclick="loadMemories('recent'); return false;" style="color: #0f0; text-decoration: none; display: block; margin: 5px;">→ Memory Viewer</a>
      </div>
    </div>
  </div>
  
  <div class="grid">
    <!-- Left Column: Conversation Testing -->
    <div>
      <div class="panel">
        <h2>💬 Conversation Test</h2>
        
        <div class="flex">
          <input type="text" id="session-id" placeholder="Session ID (auto-generate)">
          <button onclick="newSession()">New</button>
          <button onclick="loadSession()">Load</button>
        </div>
        
        <select id="persona">
          <option value="buddy">BUDDY - Enthusiastic Helper</option>
          <option value="jax">JAX - Creative Artist</option>
          <option value="lomi">LOMI - Philosophical Thinker</option>
          <option value="zorp">ZORP - Mysterious Oracle</option>
        </select>
        
        <!-- Quick Actions Bar -->
        <div style="background: #000; border: 1px solid #0f0; padding: 10px; margin: 10px 0;">
          <div style="font-size: 12px; color: #00ff00; margin-bottom: 8px;">⚡ QUICK ACTIONS</div>
          <div class="flex" style="flex-wrap: wrap; gap: 5px;">
            <button onclick="replayLastMessage()" id="replay-btn" disabled style="font-size: 11px;">🔄 Replay</button>
            <button onclick="switchPersonaKeepSession()" style="font-size: 11px;">👥 Switch Persona</button>
            <button onclick="branchSession()" style="font-size: 11px;">🌿 Branch</button>
            <button onclick="saveSession()" style="font-size: 11px;">💾 Save</button>
            <button onclick="toggleModelOverride()" id="model-btn" style="font-size: 11px;">🤖 Model</button>
            <button onclick="quickTest()" style="font-size: 11px;">⚡ Quick Test</button>
          </div>
          
          <!-- Model Selector (Hidden by default) -->
          <div id="model-selector" style="display: none; margin-top: 10px;">
            <select id="model-override" style="width: 100%;">
              <option value="">Default Model (<%= GlitchCube::ModelPresets::DEFAULT_MODEL %>)</option>
              <optgroup label="Free Models (Recommended)">
                <% GlitchCube::ModelPresets::FREE_MODELS.each do |model| %>
                  <option value="<%= model %>"><%= model %></option>
                <% end %>
              </optgroup>
              <optgroup label="Cheap Models with Tools">
                <% GlitchCube::ModelPresets::CHEAP_TOOLS_MODELS.each do |model| %>
                  <option value="<%= model %>"><%= model %></option>
                <% end %>
              </optgroup>
              <optgroup label="Conversation Models">
                <% GlitchCube::ModelPresets::CONVERSATION_MODELS.each do |model| %>
                  <option value="<%= model %>"><%= model %></option>
                <% end %>
              </optgroup>
              <optgroup label="Vision Models">
                <% GlitchCube::ModelPresets::VISION_MODELS.each do |model| %>
                  <option value="<%= model %>"><%= model %></option>
                <% end %>
              </optgroup>
              <optgroup label="Premium Models (Higher Cost)">
                <% GlitchCube::ModelPresets::PREMIUM_MODELS.each do |model| %>
                  <option value="<%= model %>"><%= model %></option>
                <% end %>
              </optgroup>
            </select>
          </div>
        </div>
        
        <!-- Enhanced Message Input -->
        <div style="position: relative;">
          <textarea id="message" rows="3" placeholder="Type your message... (Shift+Enter for new line, Enter to send)"></textarea>
          <div style="position: absolute; top: 5px; right: 8px; font-size: 11px; color: #888;">
            <span id="char-count">0</span>/500
          </div>
        </div>
        
        <!-- Template Quick-Insert -->
        <div style="margin: 5px 0;">
          <select id="message-templates" onchange="insertTemplate()" style="font-size: 11px; width: 100%;">
            <option value="">-- Quick Templates --</option>
            <option value="Hello! What are you?">First Contact</option>
            <option value="I need to get to 6:30 and Esplanade, can you help?">Ride Request</option>
            <option value="Show me everything you can do">Hardware Demo</option>
            <option value="Let's have a dance party!">Party Mode</option>
            <option value="Tell me about yourself">Self Description</option>
            <option value="What's your favorite memory?">Memory Probe</option>
            <option value="Can you see me right now?">Camera Test</option>
            <option value="Play some music">Music Test</option>
            <option value="What time is it?">Time Query</option>
            <option value="Where are we right now?">Location Query</option>
          </select>
        </div>
        
        <div>
          <button onclick="sendMessage()">💬 Send Message</button>
          <button onclick="proactiveSpeak()">🎲 Cube Initiates</button>
          <button onclick="testTTS()">🔊 Test TTS</button>
        </div>
        
        <div class="small">
          <label><input type="checkbox" id="enable-tools" checked> Enable Tools</label>
          <label><input type="checkbox" id="skip-memories"> Skip Memories</label>
          <label><input type="checkbox" id="enable-tts"> TTS Output</label>
        </div>
      </div>

      <div class="panel">
        <h2>📜 Conversation History</h2>
        <div class="flex">
          <button onclick="clearDisplay()">Clear Display</button>
          <button onclick="loadSessionHistory()">Load Full History</button>
          <button onclick="extractMemories()">Extract Memories</button>
        </div>
        <div id="conversation-display" class="history"></div>
      </div>
    </div>

    <!-- Right Column: Session Management & Debug -->
    <div>
      <div class="panel">
        <h2>📋 Recent Sessions</h2>
        <button onclick="refreshSessions()">🔄 Refresh</button>
        <div id="sessions-list" class="sessions">
          <div class="status">Click Refresh to load recent sessions</div>
        </div>
      </div>

      <div class="panel">
        <h2>🧠 Memory Viewer</h2>
        <div class="flex">
          <input type="text" id="memory-search" placeholder="Search memories...">
          <button onclick="searchMemories()">Search</button>
        </div>
        <div>
          <button onclick="loadMemories('recent')">Recent</button>
          <button onclick="loadMemories('session')">Session</button>
          <button onclick="loadMemories('popular')">Popular</button>
        </div>
        <div id="memory-display" class="history">
          <div class="status">Select a memory type to view</div>
        </div>
      </div>

      <div class="panel">
        <h2>🔧 Debug Tools</h2>
        <div>
          <button onclick="checkStatus()">System Status</button>
          <button onclick="viewLogs()">View Logs</button>
          <button onclick="testAllPersonas()">Test All Personas</button>
        </div>
        <div id="debug-output" class="history" style="max-height: 200px;">
          <div class="status">Debug output will appear here</div>
        </div>
      </div>
      
      <% if @show_gps_spoofing %>
      <div class="panel">
        <h2>📍 GPS Location Spoofing</h2>
        <div class="small" style="color: #ffaa00; margin-bottom: 10px;">⚠️ Development Only - Not available in production</div>
        
        <!-- Current Location Display -->
        <div style="background: #001100; padding: 10px; margin-bottom: 10px; border: 1px solid #333;">
          <div class="small" style="color: #888; margin-bottom: 5px;">Current Location:</div>
          <div id="current-location-display" style="font-size: 12px;">
            <% if @current_location && !@current_location[:error] %>
              <%= @current_location[:address] || 'Unknown' %> 
              (<%= @current_location[:lat]&.round(6) %>, <%= @current_location[:lng]&.round(6) %>)
              <br><span style="color: #888;">Source: <%= @current_location[:source] %></span>
            <% else %>
              <span style="color: #ff0000;">Error: <%= @current_location[:error] if @current_location %></span>
            <% end %>
          </div>
        </div>
        
        <!-- Location Search -->
        <div style="position: relative;">
          <input type="text" id="location-search" placeholder="Search landmarks..." 
                 autocomplete="off" onkeyup="searchLandmarks()" onkeydown="handleLocationKeydown(event)">
          <div id="location-suggestions" class="location-dropdown" style="display: none;"></div>
        </div>
        
        <!-- Manual Coordinates -->
        <div class="flex" style="margin: 5px 0;">
          <input type="number" id="manual-lat" placeholder="Latitude" step="0.000001" style="width: 48%;">
          <input type="number" id="manual-lng" placeholder="Longitude" step="0.000001" style="width: 48%;">
        </div>
        
        <!-- Action Buttons -->
        <div style="margin-top: 10px;">
          <button onclick="spoofLocation()">📍 Spoof Location</button>
          <button onclick="clearSpoofing()">🔄 Clear Spoofing</button>
          <button onclick="refreshCurrentLocation()">🔄 Refresh</button>
        </div>
        
        <div id="gps-status" class="small" style="margin-top: 10px; color: #888;"></div>
      </div>
      <% end %>
    </div>
  </div>

  <script>
    let currentSessionId = null;
    let recentSessions = [];
    
    // Core Functions
    function generateSessionId() {
      return 'dev_' + Date.now() + '_' + Math.random().toString(36).substr(2, 6);
    }
    
    function addToDisplay(text, className = '', targetId = 'conversation-display') {
      const display = document.getElementById(targetId);
      const div = document.createElement('div');
      div.className = 'message ' + className;
      div.textContent = text;
      display.appendChild(div);
      display.scrollTop = display.scrollHeight;
    }
    
    function addHtmlToDisplay(html, targetId = 'conversation-display') {
      const display = document.getElementById(targetId);
      const div = document.createElement('div');
      div.innerHTML = html;
      display.appendChild(div);
      display.scrollTop = display.scrollHeight;
    }
    
    // Session Management
    function newSession() {
      currentSessionId = generateSessionId();
      document.getElementById('session-id').value = currentSessionId;
      document.getElementById('conversation-display').innerHTML = '';
      addToDisplay('🆕 New session: ' + currentSessionId, 'system');
      updateRecentSessions();
    }
    
    function loadSession() {
      const sessionId = document.getElementById('session-id').value;
      if (!sessionId) return;
      
      currentSessionId = sessionId;
      addToDisplay('📂 Loading session: ' + sessionId, 'system');
      loadSessionHistory();
    }
    
    // Conversation Functions
    async function sendMessage() {
      const message = document.getElementById('message').value.trim();
      if (!message) return;
      
      if (!currentSessionId) newSession();
      
      // Store for replay
      lastUserMessage = message;
      document.getElementById('replay-btn').disabled = false;
      
      const persona = document.getElementById('persona').value;
      const enableTools = document.getElementById('enable-tools').checked;
      const skipMemories = document.getElementById('skip-memories').checked;
      const enableTts = document.getElementById('enable-tts').checked;
      const modelOverride = document.getElementById('model-override').value;
      
      // Display user message
      addToDisplay('USER: ' + message, 'user');
      document.getElementById('message').value = '';
      
      try {
        const requestBody = {
          message: message,
          context: {
            session_id: currentSessionId,
            persona: persona,
            source: 'admin_dev',
            tools: enableTools ? ['test_tool', 'weather', 'memory_search'] : [],
            skip_memories: skipMemories,
            enable_tts: enableTts,
            model_override: modelOverride || undefined
          }
        };
        
        const response = await fetch('/api/v1/conversation', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(requestBody)
        });
        
        const data = await response.json();
        
        if (data.success && data.data) {
          addToDisplay('ASSISTANT (' + persona + '): ' + (data.data.response || 'No response'), 'assistant');
          
          // Show tool calls if present (for debugging)
          if (data.data.tool_calls && data.data.tool_calls.length > 0) {
            addToDisplay(`🔧 Tools used: ${data.data.tool_calls.join(', ')}`, 'status');
          }
          
          addToDisplay(`💰 ${data.data.model || 'unknown'} | $${(data.data.cost || 0).toFixed(4)} | ${data.data.tokens?.total || '?'} tokens`, 'status');
        } else {
          addToDisplay('❌ ERROR: ' + (data.error || 'Unknown error'), 'error');
        }
      } catch (err) {
        addToDisplay('❌ NETWORK ERROR: ' + err.message, 'error');
      }
    }
    
    async function proactiveSpeak() {
      const persona = document.getElementById('persona').value;
      
      try {
        const response = await fetch('/admin/proactive_conversation', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ character: persona })
        });
        
        const data = await response.json();
        
        if (data.success) {
          addToDisplay('🎲 CUBE INITIATED (' + persona + '): ' + data.message, 'assistant');
          currentSessionId = data.session_id;
          document.getElementById('session-id').value = currentSessionId;
          updateRecentSessions();
        } else {
          addToDisplay('❌ Proactive failed: ' + data.error, 'error');
        }
      } catch (err) {
        addToDisplay('❌ Proactive error: ' + err.message, 'error');
      }
    }
    
    // History and Session Management
    async function loadSessionHistory() {
      const sessionId = currentSessionId || document.getElementById('session-id').value;
      if (!sessionId) {
        addToDisplay('No session ID specified', 'error');
        return;
      }
      
      try {
        const response = await fetch('/admin/session_history?session_id=' + encodeURIComponent(sessionId));
        const data = await response.json();
        
        if (data.messages && data.messages.length > 0) {
          document.getElementById('conversation-display').innerHTML = '';
          
          data.messages.forEach(msg => {
            const roleClass = msg.role === 'user' ? 'user' : 'assistant';
            const time = new Date(msg.created_at).toLocaleTimeString();
            const persona = msg.persona ? ` (${msg.persona})` : '';
            addToDisplay(`${msg.role.toUpperCase()}${persona} [${time}]: ${msg.content}`, roleClass);
            
            // Show tool calls if present
            if (msg.metadata && msg.metadata.tool_calls && msg.metadata.tool_calls.length > 0) {
              addToDisplay(`🔧 Tools: ${msg.metadata.tool_calls.join(', ')}`, 'status');
            }
            
            if (msg.cost) {
              addToDisplay(`💰 ${msg.model} | $${parseFloat(msg.cost).toFixed(4)} | ${msg.prompt_tokens}/${msg.completion_tokens} tokens`, 'status');
            }
          });
          
          addToDisplay(`📊 Session totals: $${data.total_cost?.toFixed(4) || '0'} | ${data.total_tokens || 0} tokens`, 'system');
        } else {
          addToDisplay('No messages found in session', 'status');
        }
      } catch (err) {
        addToDisplay('❌ Failed to load history: ' + err.message, 'error');
      }
    }
    
    async function refreshSessions() {
      addToDisplay('🔄 Refreshing sessions...', 'status', 'debug-output');
      
      // Simplified - just show current and recent sessions
      const sessionsList = document.getElementById('sessions-list');
      sessionsList.innerHTML = '';
      
      if (currentSessionId) {
        const currentDiv = document.createElement('div');
        currentDiv.className = 'session-item';
        currentDiv.style.background = '#003300';
        currentDiv.textContent = `🟢 Current: ${currentSessionId}`;
        currentDiv.onclick = () => loadSession();
        sessionsList.appendChild(currentDiv);
      }
      
      recentSessions.forEach(session => {
        if (session !== currentSessionId) {
          const div = document.createElement('div');
          div.className = 'session-item';
          div.textContent = `📋 ${session}`;
          div.onclick = () => {
            document.getElementById('session-id').value = session;
            loadSession();
          };
          sessionsList.appendChild(div);
        }
      });
      
      if (recentSessions.length === 0) {
        sessionsList.innerHTML = '<div class="status">No recent sessions</div>';
      }
    }
    
    function updateRecentSessions() {
      if (currentSessionId && !recentSessions.includes(currentSessionId)) {
        recentSessions.unshift(currentSessionId);
        if (recentSessions.length > 5) recentSessions.pop();
        refreshSessions();
      }
    }
    
    // Memory Functions
    async function loadMemories(type) {
      let url = `/admin/memories?type=${type}&limit=10`;
      
      if (type === 'session' && currentSessionId) {
        url += '&session_id=' + encodeURIComponent(currentSessionId);
      }
      
      try {
        const response = await fetch(url);
        const data = await response.json();
        
        const display = document.getElementById('memory-display');
        display.innerHTML = '';
        
        if (data.memories && data.memories.length > 0) {
          data.memories.forEach(memory => {
            const div = document.createElement('div');
            div.className = 'message';
            div.innerHTML = `
              <strong>${memory.category || 'general'}</strong> 
              <span class="small">[${new Date(memory.created_at).toLocaleDateString()}]</span><br>
              ${memory.content}<br>
              <span class="status">🔄 ${memory.recall_count || 0}x | ⚡ ${Math.round((memory.emotional_intensity || 0) * 100)}%</span>
            `;
            display.appendChild(div);
          });
          
          addToDisplay(`✅ Loaded ${data.count} ${type} memories`, 'status', 'debug-output');
        } else {
          display.innerHTML = '<div class="status">No memories found</div>';
        }
      } catch (err) {
        addToDisplay('❌ Memory load failed: ' + err.message, 'error', 'debug-output');
      }
    }
    
    async function searchMemories() {
      const query = document.getElementById('memory-search').value.trim();
      if (!query) return;
      
      try {
        const response = await fetch('/admin/memories?type=search&query=' + encodeURIComponent(query) + '&limit=10');
        const data = await response.json();
        
        const display = document.getElementById('memory-display');
        display.innerHTML = '';
        
        if (data.memories && data.memories.length > 0) {
          data.memories.forEach(memory => {
            const div = document.createElement('div');
            div.className = 'message';
            div.innerHTML = `
              <strong>${memory.category || 'general'}</strong><br>
              ${memory.content}<br>
              <span class="status">🔄 ${memory.recall_count || 0}x</span>
            `;
            display.appendChild(div);
          });
          
          addToDisplay(`🔍 Found ${data.count} memories for "${query}"`, 'status', 'debug-output');
        } else {
          display.innerHTML = '<div class="status">No memories found for your search</div>';
        }
      } catch (err) {
        addToDisplay('❌ Search failed: ' + err.message, 'error', 'debug-output');
      }
    }
    
    // Utility Functions
    async function extractMemories() {
      if (!currentSessionId) {
        addToDisplay('❌ No active session', 'error', 'debug-output');
        return;
      }
      
      try {
        const response = await fetch('/admin/extract_memories', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ session_id: currentSessionId })
        });
        
        const data = await response.json();
        addToDisplay(data.success ? '🧠 ' + data.message : '❌ ' + data.error, 
                    data.success ? 'status' : 'error', 'debug-output');
        
        if (data.success) {
          setTimeout(() => loadMemories('session'), 1000);
        }
      } catch (err) {
        addToDisplay('❌ Extract failed: ' + err.message, 'error', 'debug-output');
      }
    }
    
    async function testTTS() {
      const message = document.getElementById('message').value || 'Hello, this is a test from the admin interface';
      const persona = document.getElementById('persona').value;
      
      try {
        const response = await fetch('/admin/test_character', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ character: persona, message: message })
        });
        
        const data = await response.json();
        addToDisplay(data.success ? '🔊 TTS Success' : '❌ TTS Failed: ' + data.error, 
                    data.success ? 'status' : 'error', 'debug-output');
      } catch (err) {
        addToDisplay('❌ TTS Error: ' + err.message, 'error', 'debug-output');
      }
    }
    
    async function checkStatus() {
      try {
        const response = await fetch('/admin/status');
        const data = await response.json();
        
        const display = document.getElementById('debug-output');
        display.innerHTML = '';
        
        Object.entries(data).forEach(([key, value]) => {
          const status = value === true ? '✅' : value === false ? '❌' : '📍';
          addToDisplay(`${status} ${key}: ${value}`, 'status', 'debug-output');
        });
      } catch (err) {
        addToDisplay('❌ Status check failed: ' + err.message, 'error', 'debug-output');
      }
    }
    
    function viewLogs() {
      addToDisplay('📋 Check server console for logs', 'status', 'debug-output');
    }
    
    async function testAllPersonas() {
      const personas = ['neutral', 'buddy', 'jax', 'lomi', 'playful', 'contemplative', 'mysterious'];
      const testMessage = 'Hello, how are you today?';
      
      addToDisplay('🧪 Testing all personas with: "' + testMessage + '"', 'system', 'debug-output');
      
      for (const persona of personas) {
        document.getElementById('persona').value = persona;
        document.getElementById('message').value = testMessage;
        
        addToDisplay(`Testing ${persona}...`, 'status', 'debug-output');
        await new Promise(resolve => setTimeout(resolve, 1000)); // Small delay
        await sendMessage();
      }
      
      addToDisplay('🧪 Persona testing complete', 'system', 'debug-output');
    }
    
    function clearDisplay() {
      document.getElementById('conversation-display').innerHTML = '';
      addToDisplay('🗑️ Display cleared', 'system');
    }
    
    // Quick Action Functions
    let lastUserMessage = '';
    let savedSessions = JSON.parse(localStorage.getItem('glitchcube_saved_sessions') || '[]');
    
    function replayLastMessage() {
      if (lastUserMessage) {
        document.getElementById('message').value = lastUserMessage;
        sendMessage();
      }
    }
    
    function switchPersonaKeepSession() {
      const currentPersona = document.getElementById('persona').value;
      const personas = ['buddy', 'jax', 'lomi', 'zorp'];
      const currentIndex = personas.indexOf(currentPersona);
      const nextIndex = (currentIndex + 1) % personas.length;
      
      document.getElementById('persona').value = personas[nextIndex];
      addToDisplay(`👥 Switched to ${personas[nextIndex]} (session preserved)`, 'system');
    }
    
    function branchSession() {
      if (!currentSessionId) {
        addToDisplay('❌ No active session to branch', 'error');
        return;
      }
      
      const branchId = `${currentSessionId}_branch_${Date.now()}`;
      const oldSession = currentSessionId;
      
      // Create new branch
      currentSessionId = branchId;
      document.getElementById('session-id').value = branchId;
      
      addToDisplay(`🌿 Created branch: ${branchId}`, 'system');
      addToDisplay(`📚 Original session: ${oldSession}`, 'status');
      updateRecentSessions();
    }
    
    function saveSession() {
      if (!currentSessionId) {
        addToDisplay('❌ No session to save', 'error');
        return;
      }
      
      const sessionData = {
        id: currentSessionId,
        persona: document.getElementById('persona').value,
        timestamp: Date.now(),
        messages: Array.from(document.getElementById('conversation-display').children).map(div => ({
          content: div.textContent,
          className: div.className
        }))
      };
      
      savedSessions = savedSessions.filter(s => s.id !== currentSessionId); // Remove existing
      savedSessions.unshift(sessionData); // Add to beginning
      savedSessions = savedSessions.slice(0, 10); // Keep only 10
      
      localStorage.setItem('glitchcube_saved_sessions', JSON.stringify(savedSessions));
      addToDisplay(`💾 Session saved: ${currentSessionId}`, 'system');
    }
    
    function toggleModelOverride() {
      const selector = document.getElementById('model-selector');
      const isVisible = selector.style.display !== 'none';
      selector.style.display = isVisible ? 'none' : 'block';
      
      const btn = document.getElementById('model-btn');
      btn.textContent = isVisible ? '🤖 Model' : '🤖 Hide';
    }
    
    async function quickTest() {
      const testMessages = [
        'Hello!',
        'What can you do?',
        'Tell me something interesting'
      ];
      
      const randomMessage = testMessages[Math.floor(Math.random() * testMessages.length)];
      document.getElementById('message').value = randomMessage;
      
      addToDisplay('⚡ Quick test initiated', 'system');
      await sendMessage();
    }
    
    function insertTemplate() {
      const select = document.getElementById('message-templates');
      const template = select.value;
      if (template) {
        document.getElementById('message').value = template;
        select.selectedIndex = 0; // Reset selection
        document.getElementById('message').focus();
      }
    }
    
    function updateCharCount() {
      const message = document.getElementById('message').value;
      const count = message.length;
      const counter = document.getElementById('char-count');
      counter.textContent = count;
      counter.style.color = count > 400 ? '#ff0000' : count > 300 ? '#ffff00' : '#888';
    }
    
    // GPS Spoofing Functions
    let landmarksCache = [];
    let currentSuggestionIndex = -1;
    
    async function loadLandmarks() {
      if (landmarksCache.length > 0) return landmarksCache;
      
      try {
        const response = await fetch('/admin/landmarks');
        const data = await response.json();
        
        if (data.success) {
          landmarksCache = data.landmarks;
          return landmarksCache;
        } else {
          throw new Error(data.error);
        }
      } catch (err) {
        addToDisplay('❌ Failed to load landmarks: ' + err.message, 'error', 'debug-output');
        return [];
      }
    }
    
    async function searchLandmarks() {
      const query = document.getElementById('location-search').value.toLowerCase().trim();
      const suggestionsDiv = document.getElementById('location-suggestions');
      
      if (query.length < 2) {
        suggestionsDiv.style.display = 'none';
        return;
      }
      
      const landmarks = await loadLandmarks();
      const filtered = landmarks.filter(landmark => 
        landmark.name.toLowerCase().includes(query) ||
        (landmark.description && landmark.description.toLowerCase().includes(query)) ||
        landmark.landmark_type.toLowerCase().includes(query)
      ).slice(0, 10);
      
      if (filtered.length === 0) {
        suggestionsDiv.style.display = 'none';
        return;
      }
      
      suggestionsDiv.innerHTML = '';
      filtered.forEach((landmark, index) => {
        const item = document.createElement('div');
        item.className = 'location-item';
        item.innerHTML = `
          <div class="location-name">${landmark.name}</div>
          <div class="location-type">${landmark.landmark_type}</div>
          <div class="location-coords">${landmark.latitude.toFixed(6)}, ${landmark.longitude.toFixed(6)}</div>
        `;
        
        item.onclick = () => selectLandmark(landmark);
        suggestionsDiv.appendChild(item);
      });
      
      suggestionsDiv.style.display = 'block';
      currentSuggestionIndex = -1;
    }
    
    function handleLocationKeydown(event) {
      const suggestionsDiv = document.getElementById('location-suggestions');
      const items = suggestionsDiv.querySelectorAll('.location-item');
      
      if (items.length === 0) return;
      
      switch (event.key) {
        case 'ArrowDown':
          event.preventDefault();
          currentSuggestionIndex = Math.min(currentSuggestionIndex + 1, items.length - 1);
          updateSuggestionHighlight(items);
          break;
          
        case 'ArrowUp':
          event.preventDefault();
          currentSuggestionIndex = Math.max(currentSuggestionIndex - 1, -1);
          updateSuggestionHighlight(items);
          break;
          
        case 'Enter':
          event.preventDefault();
          if (currentSuggestionIndex >= 0 && items[currentSuggestionIndex]) {
            items[currentSuggestionIndex].click();
          }
          break;
          
        case 'Escape':
          suggestionsDiv.style.display = 'none';
          currentSuggestionIndex = -1;
          break;
      }
    }
    
    function updateSuggestionHighlight(items) {
      items.forEach((item, index) => {
        item.style.background = index === currentSuggestionIndex ? '#003300' : '';
      });
    }
    
    function selectLandmark(landmark) {
      document.getElementById('location-search').value = landmark.name;
      document.getElementById('manual-lat').value = landmark.latitude;
      document.getElementById('manual-lng').value = landmark.longitude;
      document.getElementById('location-suggestions').style.display = 'none';
      
      addToDisplay(`📍 Selected: ${landmark.name}`, 'status', 'debug-output');
    }
    
    async function spoofLocation() {
      const lat = parseFloat(document.getElementById('manual-lat').value);
      const lng = parseFloat(document.getElementById('manual-lng').value);
      const name = document.getElementById('location-search').value || 'Custom Location';
      
      if (!lat || !lng) {
        addToDisplay('❌ Please enter valid coordinates', 'error', 'debug-output');
        return;
      }
      
      try {
        const response = await fetch('/admin/spoof_gps', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            latitude: lat,
            longitude: lng,
            name: name
          })
        });
        
        const data = await response.json();
        
        if (data.success) {
          addToDisplay(`✅ ${data.message}`, 'status', 'debug-output');
          refreshCurrentLocation();
        } else {
          addToDisplay(`❌ GPS spoof failed: ${data.error}`, 'error', 'debug-output');
        }
      } catch (err) {
        addToDisplay(`❌ GPS spoof error: ${err.message}`, 'error', 'debug-output');
      }
    }
    
    async function clearSpoofing() {
      try {
        const response = await fetch('/admin/spoof_gps', {
          method: 'DELETE'
        });
        
        const data = await response.json();
        
        if (data.success) {
          addToDisplay(`✅ ${data.message}`, 'status', 'debug-output');
          refreshCurrentLocation();
          
          // Clear the form
          document.getElementById('location-search').value = '';
          document.getElementById('manual-lat').value = '';
          document.getElementById('manual-lng').value = '';
        } else {
          addToDisplay(`❌ Clear spoof failed: ${data.error}`, 'error', 'debug-output');
        }
      } catch (err) {
        addToDisplay(`❌ Clear spoof error: ${err.message}`, 'error', 'debug-output');
      }
    }
    
    async function refreshCurrentLocation() {
      try {
        const response = await fetch('/admin/current_location');
        const data = await response.json();
        
        const display = document.getElementById('current-location-display');
        
        if (data.success && data.location) {
          const loc = data.location;
          const address = loc.address || 'Unknown';
          const lat = loc.lat ? loc.lat.toFixed(6) : '?';
          const lng = loc.lng ? loc.lng.toFixed(6) : '?';
          const source = loc.source || 'unknown';
          
          display.innerHTML = `
            ${address} (${lat}, ${lng})
            <br><span style="color: #888;">Source: ${source}</span>
          `;
          
          // Show additional context if available
          if (loc.context || loc.landmark_name) {
            const context = loc.context || '';
            const landmark = loc.landmark_name || '';
            display.innerHTML += `<br><span style="color: #00ffff; font-size: 10px;">${context} ${landmark}</span>`;
          }
        } else {
          display.innerHTML = `<span style="color: #ff0000;">Error: ${data.error || 'Unknown error'}</span>`;
        }
      } catch (err) {
        const display = document.getElementById('current-location-display');
        display.innerHTML = `<span style="color: #ff0000;">Error: ${err.message}</span>`;
      }
    }
    
    // Hide location suggestions when clicking elsewhere
    document.addEventListener('click', (e) => {
      if (!e.target.closest('#location-search') && !e.target.closest('#location-suggestions')) {
        document.getElementById('location-suggestions').style.display = 'none';
        currentSuggestionIndex = -1;
      }
    });

    // Event Listeners
    document.addEventListener('DOMContentLoaded', () => {
      // Enter key to send message
      document.getElementById('message').addEventListener('keypress', (e) => {
        if (e.key === 'Enter' && !e.shiftKey) {
          e.preventDefault();
          sendMessage();
        }
      });
      
      // Character counter
      document.getElementById('message').addEventListener('input', updateCharCount);
      
      // Enter key to search memories
      document.getElementById('memory-search').addEventListener('keypress', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          searchMemories();
        }
      });
      
      // Auto-start with new session
      newSession();
    });
  </script>
</body>
</html>