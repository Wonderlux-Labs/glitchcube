# Production Environment Overrides
# This file is loaded when RACK_ENV=production

# Production database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/glitchcube_production

# Production features
SIMULATE_CUBE_MOVEMENT=false
LOG_LEVEL=info

# Self-healing mode
SELF_HEALING=DRY_RUN
SELF_HEALING_MIN_CONFIDENCE=0.7
SELF_HEALING_ERROR_THRESHOLD=3

# Production Home Assistant (override if needed)
# HOME_ASSISTANT_URL=http://100.126.250.73:8123