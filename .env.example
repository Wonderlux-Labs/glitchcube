# Glitch Cube Environment Configuration
# Copy this file to .env and update with your values

# =============================
# REQUIRED: AI Configuration
# =============================
# OpenRouter API key (primary AI provider)
OPENROUTER_API_KEY=your-openrouter-api-key-here

# =============================
# REQUIRED: Home Assistant
# =============================
# Home Assistant long-lived access token
HOME_ASSISTANT_TOKEN=your-home-assistant-token-here

# =============================
# OPTIONAL: Override Defaults
# =============================
# Only set these if you need to override the built-in defaults

# Application Environment
# RACK_ENV=development

# Database (defaults to PostgreSQL on localhost)
# DATABASE_URL=postgresql://localhost:5432/glitchcube_development

# Redis (defaults to localhost)
# REDIS_URL=redis://localhost:6379/0

# Home Assistant URL (defaults to production HA)
# HOME_ASSISTANT_URL=http://localhost:8123

# AI Configuration (has sensible defaults)
# AI_TEMPERATURE=0.8
# AI_MAX_TOKENS=2000
# MAX_SESSION_MESSAGES=10

# Session secret (auto-generated if not set)
# SESSION_SECRET=generate-with-SecureRandom.hex(64)

# Logging
# LOG_LEVEL=info
# LOG_TO_SCREEN=true

# Device Information
# DEVICE_ID=glitch_cube_001
# INSTALLATION_LOCATION=Black Rock City
# APP_VERSION=1.0.0

# Development Features
# DEBUG=false
# CONVERSATION_TRACING=false

# Self-Healing Error Handler (defaults to DRY_RUN)
# SELF_HEALING=DRY_RUN
# SELF_HEALING_MIN_CONFIDENCE=0.85
# SELF_HEALING_ERROR_THRESHOLD=2

# =============================
# PRODUCTION ONLY
# =============================
# These should only be set in production

# Deployment API Keys
# GITHUB_WEBHOOK_SECRET=your-github-webhook-secret
# DEPLOYMENT_API_KEY=your-deployment-api-key

# External Services
# UPTIME_KUMA_PUSH_URL=your-monitoring-url
# HELICONE_API_KEY=your-helicone-key

# Additional AI Providers (if using directly)
# OPENAI_API_KEY=your-openai-key
# ANTHROPIC_API_KEY=your-anthropic-key