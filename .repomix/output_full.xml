test_get() {
    local endpoint="$1"
    local description="$2"
    local expected_status="${3:-200}"
    
    ((TOTAL_COUNT++))
    echo -n "Testing GET $endpoint ($description)... "
    
    response=$(curl -s -w "\n%{http_code}" "$BASE_URL$endpoint" 2>/dev/null)
    status_code=$(echo "$response" | tail -n1)
    
    if [[ "$status_code" == "$expected_status" ]]; then
