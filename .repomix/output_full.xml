require 'sinatra/base'
require 'json'
module Routes
  module Admin
    module Scenarios
      # Predefined test scenarios
      def self.save_comparison
        Services::AdminPages.save_comparison
      end
      SCENARIOS = {
        'first_contact' => {
          name: 'First Contact',
          category: 'basic',
          description: 'Initial interaction with the cube',
          messages: [
            { role: 'user', content: 'Hello! What are you?' },
