          name: 'The Temple',
          lat: 40.791815,
          lng: -119.196622,
          radius: 15,
          type: 'sacred',
          context: 'Approaching the Temple 🏛️'
        },
        {
          name: 'The Man',
          lat: 40.786963,
          lng: -119.203007,
          radius: 15,
          type: 'center',
          context: 'Near The Man 🔥'
        }
      ]
    end
  end
end
