#!/usr/bin/env ruby
# frozen_string_literal: true

# Console script for interactive debugging with Pry
# Usage: bin/console

require 'bundler/setup'
require 'pry'
require 'dotenv/load'

# Load enhanced debugging gems
begin
  require 'pry-byebug'
  require 'pry-doc'
  require 'amazing_print'

  # Configure amazing_print for better object inspection
  AmazingPrint.defaults = {
    indent: 2,
    index: false,
    color: {
      hash: :blue,
      array: :green,
      string: :yellow
    }
  }
rescue LoadError
  # Gracefully handle missing gems
end

# Load environment variables
Dotenv.load('.env', '.env.defaults')

# Set the environment
ENV['RACK_ENV'] ||= 'development'

# Ensure Sidekiq runs inline for console sessions (safer for interactive use)
ENV['SIDEKIQ_INLINE'] ||= 'true'

# Load the app properly with all its initializers and correct load order
require_relative '../app'

# Models should already be loaded by the app, but load them if not
if defined?(ActiveRecord) && !defined?(Conversation)
  Dir[File.join(__dir__, '../app/models/**/*.rb')].each { |f| require f }
end

# Helper methods available in console
module ConsoleHelpers
  def reload!
    puts '🔄 Reloading...'

    # Clear Ruby's loaded features for our app files
    $LOADED_FEATURES.reject! { |f| f.include?('/glitchcube/') }

    # Reload the app with proper load order
    load File.join(__dir__, '../app.rb')

    # Reload models if needed
    if defined?(ActiveRecord)
      Dir[File.join(__dir__, '../app/models/**/*.rb')].each { |f| load f }
    end

    puts '✅ Reloaded!'
    true
  end

  def app
    @app ||= Sinatra::Application
  end

  def ha
    @ha ||= HomeAssistantClient.new
  end

  def tts(character = :default)
    @tts ||= {}
    @tts[character] ||= Services::CharacterService.new(character: character)
  end

  def llm_service
    @llm_service ||= Services::Llm::LLMService.new
  end

  # Keep openrouter method for backward compatibility during transition
  def openrouter
    @openrouter ||= llm_service
  end

  def config
    GlitchCube.config
  end

  def test_speak(message = 'Hello from the console!', character = :default)
    tts(character).speak(message)
  end

  def test_conversation(message = "What's your purpose?")
    handler = Services::ConversationHandlerService.new
    response = handler.process(message)
    puts response[:message]
    response
  end

  def list_characters
    Services::CharacterService::CHARACTERS.keys
  end

  def switch_character(name)
    character = Services::CharacterService::CHARACTERS[name.to_sym]
    if character
      puts "🎭 Switched to #{character[:name]}"
      puts "   #{character[:description]}"
      tts(name)
    else
      puts "❌ Character not found. Available: #{list_characters.join(', ')}"
    end
  end

  def test_models
    puts 'Testing LLM Service connection...'
    # NOTE: LLMService doesn't expose available_models directly
    # Test with a simple completion instead
    response = llm_service.complete_cheap_no_tools(
      'Say "Hello from LLM Service!"',
      model: 'openai/gpt-4o-mini'
    )
    puts "✅ LLM Service working! Response: #{response.content&.strip}"
  rescue StandardError => e
    puts "❌ Error: #{e.message}"
  end

  def test_ha
    puts 'Testing Home Assistant connection...'
    states = ha.states
    puts "✅ Connected! Found #{states.count} entities"
    states.first(5).each do |state|
      puts "  - #{state['entity_id']}: #{state['state']}"
    end
  rescue StandardError => e
    puts "❌ Error: #{e.message}"
  end

  # Agent-friendly debugging methods
  def debug_conversation(message = 'Debug test message')
    puts "🐛 Debugging conversation flow for: '#{message}'"

    # Show the conversation module in action
    handler = Services::Conversation::ConversationFlowManager.new

    puts "\n📋 Flow manager created"
    puts "   Class: #{handler.class}"

    begin
      response = handler.process(message, session_id: 'debug-session')
      puts "\n✅ Response received:"
      ap response if defined?(AmazingPrint)
      response
    rescue StandardError => e
      puts "\n❌ Error during conversation:"
      puts "   #{e.class}: #{e.message}"
      puts '   Backtrace (first 5 lines):'
      e.backtrace.first(5).each { |line| puts "     #{line}" }
      nil
    end
  end

  def debug_entities
    puts '🏠 Debugging Home Assistant entities...'

    begin
      entity_service = GlitchCube::Services::EntityManagerService
      entities = entity_service.get_entities_by_domain

      puts "\n📊 Entity Summary:"
      entities.each do |domain, domain_entities|
        puts "   #{domain}: #{domain_entities.count} entities"
      end

      # Show some examples
      if entities['light']&.any?
        puts "\n💡 Light entities (first 3):"
        entities['light'].first(3).each do |entity|
          puts "   - #{entity['entity_id']}: #{entity['state']}"
        end
      end

      entities
    rescue StandardError => e
      puts "❌ Error: #{e.message}"
      nil
    end
  end

  def debug_memory
    puts '🧠 Debugging memory system...'

    begin
      # Show recent conversations
      recent = Conversation.recent.limit(3)
      puts "\n📖 Recent conversations (#{recent.count}):"
      recent.each do |conv|
        puts "   #{conv.created_at.strftime('%H:%M')} - #{conv.user_message&.truncate(50)}"
      end

      # Show memory consolidation status
      if defined?(Jobs::MemoryConsolidationJob)
        puts "\n🔄 Memory consolidation available: ✅"
      else
        puts "\n🔄 Memory consolidation: ❌ (not loaded)"
      end

      recent
    rescue StandardError => e
      puts "❌ Error: #{e.message}"
      nil
    end
  end

  def debug_tools
    puts '🛠️  Debugging tool system...'

    begin
      # List available tools
      if defined?(GlitchCube::Tools)
        tool_classes = Object.constants.grep(/Tool$/).map { |c| Object.const_get(c) }
                             .select { |c| c.is_a?(Class) && c.ancestors.include?(BaseTool) }

        puts "\n🔧 Available tools (#{tool_classes.count}):"
        tool_classes.each do |tool_class|
          puts "   - #{tool_class.name}"
        end

        tool_classes
      else
        puts "\n❌ Tool system not loaded"
        []
      end
    rescue StandardError => e
      puts "❌ Error: #{e.message}"
      nil
    end
  end

  # Agent workflow helper
  def agent_debug_workflow(message = 'Test message')
    puts '🤖 AGENT DEBUG WORKFLOW'
    puts '=' * 50

    puts "\n1️⃣  Testing conversation flow..."
    debug_conversation(message)

    puts "\n2️⃣  Checking entities..."
    debug_entities

    puts "\n3️⃣  Reviewing memory..."
    debug_memory

    puts "\n4️⃣  Validating tools..."
    debug_tools

    puts "\n✅ Agent debug workflow complete"
  end

  def help
    puts <<~HELP
      🎮 GlitchCube Console Commands:

      Core Objects:
        app           - Sinatra application instance
        ha            - HomeAssistantClient instance
        tts(char)     - TTS service for character (default: :default)
        llm_service   - LLM Service instance
        openrouter    - LLM Service instance (backward compatibility)
        config        - GlitchCube configuration

      Testing:
        test_speak(msg, char)  - Test TTS with message and character
        test_conversation(msg) - Test conversation handler
        test_models           - Test LLM Service connection
        test_ha              - Test Home Assistant connection

      Characters:
        list_characters      - Show available characters
        switch_character(name) - Switch to a character

      Agent-Friendly Debugging:
        debug_conversation(msg) - Debug conversation flow step-by-step
        debug_entities         - Debug Home Assistant entity system
        debug_memory          - Debug memory and conversation history
        debug_tools           - Debug available tools
        agent_debug_workflow(msg) - Run complete debugging workflow

      Utilities:
        reload!             - Reload all application code
        help               - Show this help message

      Examples:
        tts(:buddy).speak("Hello!")
        test_conversation("Tell me a joke")
        switch_character(:jax)
        ha.states
        agent_debug_workflow("Debug the system")
    HELP
  end
end

# Include helpers in the console
include ConsoleHelpers

# Set up a nice prompt
Pry.config.prompt = Pry::Prompt.new(
  'glitchcube',
  'GlitchCube interactive console',
  [
    proc { |_obj, nest_level, _|
      prompt = '🎲 glitchcube'
      prompt += ":#{nest_level}" if nest_level.positive?
