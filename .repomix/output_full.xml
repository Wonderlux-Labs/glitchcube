#!/usr/bin/env bash
# Development script to run app with auto-reload and sidekiq

set -e

# Kill any existing Sinatra and Sidekiq processes
echo "🧹 Cleaning up existing processes..."
lsof -ti:4567 | xargs kill -9 2>/dev/null || true
pkill -f sidekiq 2>/dev/null || true
pkill -f "ruby app.rb" 2>/dev/null || true
sleep 1

echo "🎲 Starting GlitchCube in development mode..."
echo "================================"
echo "App: http://localhost:4567"
echo "Press Ctrl-C to stop all services"
echo ""

# Function to kill all background processes on exit
cleanup() {
    echo ""
    echo "🛑 Shutting down services..."
    kill $(jobs -p) 2>/dev/null || true
    exit 0
}

# Set up trap to cleanup on Ctrl-C
trap cleanup INT TERM

# Check if we should run Sidekiq as separate process
if [ "${SIDEKIQ_INLINE}" = "false" ]; then
    echo "🔄 Starting in background mode (SIDEKIQ_INLINE=false)"
    
    # Start Sidekiq in background first
    echo "🚀 Starting Sidekiq..."
    bundle exec sidekiq -C config/sidekiq/sidekiq.yml -r ./config/sidekiq/sidekiq_boot.rb &
    SIDEKIQ_PID=$!
    echo "Sidekiq started with PID: $SIDEKIQ_PID"
    
    # Give Sidekiq a moment to start
    sleep 2
    
    # Start the app with rerun (in foreground)
    echo "🚀 Starting app with auto-reload..."
    bundle exec rerun --background --dir . --pattern '**/*.{rb,yml,erb}' -- ruby app.rb
    
    # This will only be reached if rerun fails to start
    wait $SIDEKIQ_PID
else
    echo "⚡ Starting in inline mode (jobs run synchronously)"
    echo "   Use SIDEKIQ_INLINE=false to run Sidekiq as separate process"
    
    # Start the app with rerun (Sidekiq will run inline)
    echo "🚀 Starting app with auto-reload..."
    bundle exec rerun --dir . --pattern '**/*.{rb,yml,erb}' -- ruby app.rb
fi
