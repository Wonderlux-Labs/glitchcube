#!/usr/bin/env bash
# Production script to run app and sidekiq

set -e

# Set Ruby environment explicitly to avoid asdf/shell integration issues
export PATH="$HOME/.asdf/installs/ruby/3.4.1/bin:$HOME/.asdf/shims:$PATH"
export RUBY_ROOT="$HOME/.asdf/installs/ruby/3.4.1"
export GEM_HOME="$HOME/.asdf/installs/ruby/3.4.1/lib/ruby/gems/3.4.0"
export GEM_PATH="$GEM_HOME"
export RACK_ENV='production'
export APP_ENV='production'
echo "🎲 Starting GlitchCube in production mode..."
echo "================================"
echo "App: http://localhost:4567"
echo "Press Ctrl-C to stop all services"
echo ""

# Function to kill all background processes on exit
cleanup() {
    echo ""
    echo "🛑 Shutting down services..."
    if [ ! -z "$SIDEKIQ_PID" ]; then
        echo "Stopping Sidekiq (PID: $SIDEKIQ_PID)..."
        kill $SIDEKIQ_PID 2>/dev/null || true
    fi
    if [ ! -z "$APP_PID" ]; then
        echo "Stopping App (PID: $APP_PID)..."
        kill $APP_PID 2>/dev/null || true
    fi
    exit 0
}

# Set up trap to cleanup on Ctrl-C
trap cleanup INT TERM

# Export production environment
export RACK_ENV=production

# Start Sidekiq in background
echo "🚀 Starting Sidekiq..."
bundle exec sidekiq -C config/sidekiq/sidekiq.yml -r ./config/sidekiq/sidekiq_boot.rb &
SIDEKIQ_PID=$!
echo "Sidekiq started with PID: $SIDEKIQ_PID"

# Give Sidekiq a moment to start
sleep 2

# Clear old/stuck jobs from previous runs
echo "🗑️  Clearing old Sidekiq jobs..."
bundle exec ruby -r './config/environment' -e "
require 'sidekiq/api'
%w[default critical low summaries].each do |q|
  size = Sidekiq::Queue.new(q).size
  Sidekiq::Queue.new(q).clear
  puts \"   Cleared #{q}: \#{size} jobs\" if size > 0
end
retry_size = Sidekiq::RetrySet.new.size
Sidekiq::RetrySet.new.clear if retry_size > 0
dead_size = Sidekiq::DeadSet.new.size  
Sidekiq::DeadSet.new.clear if dead_size > 0
puts '✅ Queue cleanup complete'
"

# Start the app in background
echo "🚀 Starting app..."
bundle exec ruby app.rb &
APP_PID=$!
echo "App started with PID: $APP_PID"

# Wait for both processes
echo ""
echo "✅ All services running. Press Ctrl-C to stop."
wait $SIDEKIQ_PID $APP_PID
</file>

