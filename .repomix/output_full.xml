  description 'List available characters'

  def process
    Services::CharacterService::CHARACTERS.each do |key, char|
      output.puts "#{key.to_s.ljust(10)} - #{char[:name]} (#{char[:voice_id]})"
      output.puts "             #{char[:description]}"
      output.puts ''
    end
  end
end

